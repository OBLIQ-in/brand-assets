{
  "name": "Obliq Brand Palette",
  "version": "1.0.0",
  "colors": {
    "cream": {
      "hex": "#f5f0e8",
      "rgb": "rgb(245, 240, 232)",
      "cssVariable": "--obliq-cream",
      "use": "Primary text, light mode background"
    },
    "creamDark": {
      "hex": "#e8e0cc",
      "rgb": "rgb(232, 224, 204)",
      "cssVariable": "--obliq-cream-dark",
      "use": "Muted text, subtle borders in light mode"
    },
    "lime": {
      "hex": "#c8f560",
      "rgb": "rgb(200, 245, 96)",
      "cssVariable": "--obliq-lime",
      "use": "Primary accent, CTAs, highlight badges, active states"
    },
    "limeLight": {
      "hex": "#dffb8c",
      "rgb": "rgb(223, 251, 140)",
      "cssVariable": "--obliq-lime-light",
      "use": "Hover states on lime buttons, glow shadows"
    },
    "periwinkle": {
      "hex": "#7b8cde",
      "rgb": "rgb(123, 140, 222)",
      "cssVariable": "--obliq-periwinkle",
      "use": "Secondary accent, domain tag (.in), status tags"
    },
    "periwinkleLight": {
      "hex": "#aab4ee",
      "rgb": "rgb(170, 180, 238)",
      "cssVariable": "--obliq-periwinkle-light",
      "use": "Periwinkle highlights, secondary glows"
    },
    "charcoal": {
      "hex": "#1a1a2e",
      "rgb": "rgb(26, 26, 46)",
      "cssVariable": "--obliq-charcoal",
      "use": "Dark page background, high-contrast dark elements"
    },
    "charcoal2": {
      "hex": "#16213e",
      "rgb": "rgb(22, 33, 62)",
      "cssVariable": "--obliq-charcoal-2",
      "use": "Elevated surfaces, card backgrounds"
    },
    "slate": {
      "hex": "#2d3561",
      "rgb": "rgb(45, 53, 97)",
      "cssVariable": "--obliq-slate",
      "use": "Borders, dividers, card outlines"
    },
    "muted": {
      "hex": "#6b7280",
      "rgb": "rgb(107, 114, 128)",
      "cssVariable": "--obliq-muted",
      "use": "Secondary metadata, timestamps, subtle labels"
    }
  },
  "typography": {
    "fontBody": "Inter, system-ui, sans-serif",
    "fontDisplay": "Plus Jakarta Sans, sans-serif",
    "fontMono": "'Courier New', monospace"
  }
}
